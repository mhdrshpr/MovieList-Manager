# ==================== MovieManager .env.example ====================
# یک کپی از این فایل با نام .env بسازید و مقادیر واقعی را وارد کنید.
# هرگز فایل .env را در مخزن عمومی قرار ندهید.

# --- Environment ---
APP_ENV=production
APP_URL=/
APP_NAME=MovieManager

# --- Database ---
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_CHARSET=utf8mb4

# --- Session ---
SESSION_NAME=MOVIE_SESSION
SESSION_LIFETIME=86400
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# --- Security ---
SESSION_REGENERATE_ON_LOGIN=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15